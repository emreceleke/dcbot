# ─── Discord ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=
DEV_GUILD_ID=

# ─── Lavalink ───────────────────────────────────────────────────────────────
# Public test node (paylasimli). Kendi node'unu kurunca asagidaki 4 satiri degistir.
LAVALINK_HOST=lavalinkv4.serenetia.com
LAVALINK_PORT=443
LAVALINK_PASSWORD=https://seretia.link/discord
LAVALINK_SECURE=true
LAVALINK_NAME=public

# ─── Bot davranisi ──────────────────────────────────────────────────────────
DEFAULT_VOLUME=80
SEARCH_PLATFORM=ytmsearch
MAX_PLAYLIST_SIZE=100
AUTOPLAY=true

# ─── Oto-rol ────────────────────────────────────────────────────────────────
# Sunucuya yeni katilanlara verilecek rol. Portal'da "Server Members Intent"
# acik olmali. AUTO_ROLE_ID doluysa isim yerine o kullanilir.
AUTO_ROLE=true
AUTO_ROLE_NAME=HUMAN
AUTO_ROLE_ID=

# ─── Oneri motoru (opsiyonel) ───────────────────────────────────────────────
LASTFM_API_KEY=

# ─── Log ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info